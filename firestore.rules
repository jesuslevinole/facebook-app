rules_version = '2';

/* ============================================================
   RedLink — reglas de Firestore

   Elige UN bloque, publícalo y comenta el resto.

   · ARRANQUE      — todo abierto. Solo para el primer día.
   · CON INVITADOS — exige sesión (incluida la anónima del modo invitado).
   · ESTRICTAS     — cada operación validada contra los permisos del rol.
                     El modo invitado NO funciona con estas.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- OPCIÓN A · ARRANQUE ----------
    // Cualquiera con la URL puede leer y escribir. Úsalo solo mientras
    // configuras; no lo dejes cuando el equipo cargue clientes reales.
    match /{document=**} {
      allow read, write: if true;
    }


    // ---------- OPCIÓN B · CON INVITADOS ----------
    // Exige una sesión de Firebase, que puede ser anónima. El botón
    // "Entrar sin sesión" sigue funcionando y puede guardar.
    //
    // Qué protege: bots y visitantes casuales que abren la URL sin ejecutar
    // el JavaScript de la app. Qué NO protege: alguien decidido que abra la
    // app y toque el botón de invitado. Es un punto intermedio, no un cierre.
    //
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }


    // ---------- OPCIÓN C · ESTRICTAS ----------
    // Cada operación se valida contra los permisos del rol de quien la pide.
    // Requiere que todos entren con correo y clave: en modo invitado la app
    // se verá vacía y no podrá guardar nada.
    //
    // function perfil() {
    //   return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    // }
    //
    // function habilitado() {
    //   return request.auth != null
    //     && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
    //     && perfil().activo == true;
    // }
    //
    // function permisos() {
    //   return get(/databases/$(database)/documents/roles/$(perfil().rolId)).data.permisos;
    // }
    //
    // function puede(p) {
    //   return habilitado() && p in permisos();
    // }
    //
    // match /usuarios/{uid} {
    //   allow read: if habilitado() || request.auth.uid == uid;
    //   allow write: if puede('usuarios.gestionar');
    // }
    //
    // match /roles/{id} {
    //   allow read: if request.auth != null;
    //   allow write: if puede('usuarios.gestionar');
    // }
    //
    // match /clientes/{id} {
    //   // Solo el dueño, con quien lo compartió, o quien puede ver a todo el equipo.
    //   allow read: if puede('clientes.verTodos')
    //     || (puede('clientes.ver') && (resource.data.uid == request.auth.uid
    //         || request.auth.uid in resource.data.compartidoCon));
    //   allow create: if puede('clientes.editar') && request.resource.data.uid == request.auth.uid;
    //   allow update: if puede('clientes.editar') && (resource.data.uid == request.auth.uid
    //     || request.auth.uid in resource.data.compartidoCon);
    //   allow delete: if puede('clientes.editar') && resource.data.uid == request.auth.uid;
    // }
    //
    // match /membresias/{id} {
    //   allow read: if habilitado();
    //   // Cada vendedor solo gestiona sus propias membresías.
    //   allow write: if habilitado() && id.split('_')[0] == request.auth.uid;
    // }
    //
    // match /rutas/{id} {
    //   // La ruta del día es privada de cada vendedor.
    //   allow read, write: if habilitado() && id.split('_')[0] == request.auth.uid;
    // }
    //
    // match /publicaciones/{id} {
    //   allow read: if habilitado();
    //   allow create: if puede('publicar') && request.resource.data.uid == request.auth.uid;
    //   allow delete: if puede('publicar') && resource.data.uid == request.auth.uid;
    //   allow update: if false;
    // }
    //
    // // Grupos y mensajes son de cada vendedor. Los que tienen `uid` vacío
    // // vienen del catálogo compartido antiguo y siguen visibles para todos.
    // match /grupos/{id} {
    //   allow read: if habilitado()
    //     && (resource.data.uid == '' || resource.data.uid == request.auth.uid);
    //   allow create: if puede('grupos.editar')
    //     && request.resource.data.uid == request.auth.uid;
    //   allow update, delete: if puede('grupos.editar')
    //     && (resource.data.uid == '' || resource.data.uid == request.auth.uid);
    // }
    //
    // match /plantillas/{id} {
    //   allow read: if habilitado()
    //     && (resource.data.uid == '' || resource.data.uid == request.auth.uid);
    //   allow create: if puede('mensajes.editar')
    //     && request.resource.data.uid == request.auth.uid;
    //   allow update, delete: if puede('mensajes.editar')
    //     && (resource.data.uid == '' || resource.data.uid == request.auth.uid);
    // }
    //
    // match /ajustes/{id} {
    //   allow read: if habilitado();
    //   allow write: if puede('ajustes.editar');
    // }
  }
}
