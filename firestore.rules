rules_version = '2';

/* ============================================================
   RedLink — reglas de Firestore

   Se usan en dos etapas:

   ETAPA 1 · ARRANQUE (lo que está activo ahora)
     Permite escribir sin sesión porque la primera cuenta y los roles base
     se crean *antes* de que exista alguien autenticado. Sirve solo para
     ese primer momento.

   ETAPA 2 · PRODUCCIÓN
     Apenas hayas creado tu cuenta de administrador desde la pantalla de
     acceso: comenta el bloque de ARRANQUE, descomenta el de PRODUCCIÓN y
     vuelve a publicar las reglas. Desde ahí cada operación se valida
     contra los permisos del rol de quien la pide.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ETAPA 1 · ARRANQUE (quitar tras crear el admin) ----------
    match /{document=**} {
      allow read, write: if true;
    }

    // ---------- ETAPA 2 · PRODUCCIÓN ----------
    // function perfil() {
    //   return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    // }
