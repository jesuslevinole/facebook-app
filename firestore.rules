    //   allow write: if puede('usuarios.gestionar');
    // }
    //
    // match /roles/{id} {
    //   allow read: if request.auth != null;
    //   allow write: if puede('usuarios.gestionar');
    // }
    //
    // match /clientes/{id} {
    //   allow read: if puede('clientes.ver');
    //   // El dueño se fija al crear y no se puede suplantar.
    //   allow create: if puede('clientes.editar') && request.resource.data.uid == request.auth.uid;
    //   allow update, delete: if puede('clientes.editar');
    // }
    //
    // match /publicaciones/{id} {
    //   allow read: if habilitado();
    //   allow create: if puede('publicar') && request.resource.data.uid == request.auth.uid;
    //   // Solo se puede deshacer el registro propio.
