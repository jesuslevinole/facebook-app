    //     && perfil().activo == true;
    // }
    //
    // function permisos() {
    //   return get(/databases/$(database)/documents/roles/$(perfil().rolId)).data.permisos;
    // }
    //
    // function puede(p) {
    //   return habilitado() && p in permisos();
    // }
    //
